# ============================================================
#  Docker-Assistant 环境变量（可选）
#  复制为 .env 后按需修改；不创建 .env 时全部使用默认值
# ============================================================

# 服务对外端口
APP_PORT=8000

# 时区
TZ=Asia/Shanghai

# 国内加速：pip 安装源（构建镜像时使用）
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn